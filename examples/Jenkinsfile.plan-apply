pipeline {
    agent none
    stages {
        stage('OCI plan') {
            options {
                ociRmProvision(
                    connection: 'oci-prod',
                    stackId: 'ocid1.ormstack.oc1.eu-frankfurt-1.example',
                    mode: 'plan',
                    operationKey: 'oci-plan',
                    waitForCompletion: true
                )
            }
            steps { echo 'Plan completed.' }
        }
        stage('OCI apply') {
            options {
                ociRmProvision(
                    connection: 'oci-prod',
                    stackId: 'ocid1.ormstack.oc1.eu-frankfurt-1.example',
                    mode: 'apply',
                    planOperationKey: 'oci-plan',
                    operationKey: 'oci-apply',
                    waitForCompletion: true,
                    timeoutMinutes: 90
                )
            }
            steps { echo 'Apply completed.' }
        }
    }
}
